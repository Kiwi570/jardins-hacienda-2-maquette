# Exemple de configuration. Copier en .env (jamais dans le dépôt) ou saisir ces variables chez l'hébergeur.
# Aucun secret ne doit figurer dans un fichier suivi par git.
DATABASE_URL=postgres://utilisateur:mot-de-passe@hote:5432/hacienda_recette
PORT=3000
# L'adresse exacte du site qui appelle l'API (les écritures venues d'ailleurs sont refusées).
JH_ORIGINE=https://recette.exemple.fr
# recette ou production : affiché dans l'espace, jamais mélangés (une base par environnement).
JH_ENV=recette
# L'identifiant de livraison (le commit), pour rapprocher le code, les tests et la version en ligne.
JH_LIVRAISON=
